{
  "types": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "docs", "section": "Documentation" },
    { "type": "style", "section": "Style" },
    { "type": "refactor", "section": "Refactorings" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "test", "section": "Tests" },
    { "type": "chore", "hidden": true }
  ],
  "commitUrlFormat": "https://gitlab.com/webdoxclm/develop/design-system/commits/{{hash}}",
  "compareUrlFormat": "https://gitlab.com/webdoxclm/develop/design-system/compare/{{previousTag}}...{{currentTag}}",
  "releaseCommitMessageFormat": "chore(release): {{currentTag}} \n\n[release-00][release]"
}
