  "repository": {
    "type": "git",
    "url": "git@gitlab.com:webdoxclm/arq/design-system.git"
  },
  "scripts": {
    "prepare": "if [ -f .husky/install.mjs ]; then node .husky/install.mjs; fi",
    "pre:storybook": "cp ./CHANGELOG.md ./src",
    "storybook": "npm run pre:storybook && storybook dev -p 6006",
    "lint": "eslint --fix",
    "registry:publish": "npm run build:package && npm publish",
    "test": "eslint --max-warnings=0 && vitest --coverage",
    "test:dev": "vitest",
    "test:watch": "vitest watch",
    "release": "npm run build && standard-version",
    "release:minor": "git fetch --tags -f && npm run build && standard-version --release-as minor",
    "release:patch": "git fetch --tags -f && npm run build && standard-version --release-as patch",
    "release:major": "git fetch --tags -f && npm run build && standard-version --release-as major",
    "build:package": "vite build && cp package.json dist/package.json",
    "build:storybook": "npm run pre:storybook && storybook build -o ./storybook-build",
    "build": "npm run build:package && npm run build:storybook",
    "publish:yalc": "npx yalc publish ./dist",
    "build:publish": "npm run build:package && npm run publish:yalc",
    "verdaccio:unpublish": "npm unpublish @webdoxclm/design-system@99.99.99 --registry http://localhost:4873 --force",
    "verdaccio:publish": "cd dist && npm pkg set version=99.99.99 && npm publish --registry http://localhost:4873",
    "verdaccio:build": "npm run build:package && (npm run verdaccio:unpublish || true) && npm run verdaccio:publish"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
